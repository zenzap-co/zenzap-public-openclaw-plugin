{
  "name": "@zenzap-co/openclaw-plugin",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "pnpm -r run build",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts'",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint --fix 'packages/*/src/**/*.ts'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.56.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.3.3",
      "postcss": "^8.5.14",
      "rollup": "^4.60.3",
      "flatted": "^3.4.2",
      "picomatch": "^4.0.4",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.5",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7"
    }
  }
}
